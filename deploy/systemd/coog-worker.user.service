[Unit]
Description=Coog worker (user)
After=network-online.target coog-api.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/coog-worker
EnvironmentFile=-%h/.config/coog/coog.env
Restart=on-failure
RestartSec=5

Environment=COOG_LIBRARY_PATH=%h/Videos
Environment=COOG_DATA_PATH=%h/.local/share/coog

[Install]
WantedBy=default.target
